# Server
APP_PORT=4000
NODE_ENV=development

# PostgreSQL (the root docker-compose.yml provides one on localhost:5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/al_ihsan_platform?schema=public"

# Auth
JWT_KEY="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# Comma-separated list of origins allowed by CORS
CORS_ORIGINS="http://localhost:5173,http://localhost:8080"

# Where uploaded claim documents are stored on disk (served at /uploads)
UPLOAD_DIR="uploads"

# Password given to every demo account created by `npm run db:seed`
SEED_PASSWORD="Console123!"

# The account everyone pays into when they choose bank transfer on the website.
PAYMENT_BANK_NAME="Zenith Bank"
PAYMENT_ACCOUNT_NUMBER="12345678908"
PAYMENT_ACCOUNT_NAME="Alihsan Health Service"
